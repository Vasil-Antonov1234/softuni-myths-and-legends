<main class="create">
    <!-- create Page (Only for logged-in users) -->
    <section id="create">
        <div class="form">
            <h2>create Myth or Legend</h2>
            <form class="create-form" method="POST">
                <input type="text" id="name" name="name" placeholder="Name" value="{{mythData.name}}" />
                <input type="text" id="origin" name="origin" placeholder="Origin (e.g. Greek, Norse, Egyptian)" value="{{mythData.origin}}" />
                <input type="text" id="role" name="role" placeholder="Role" value="{{mythData.role}}" />
                <input type="text" id="myth-img" name="image" placeholder="Image URL" value="{{mythData.image}}" />
                <input type="text" id="symbol" name="symbol" placeholder="Symbol / Attribute" value="{{mythData.symbol}}" />
                <input type="text" id="era" name="era" placeholder="Era or Period" value="{{mythData.era}}" />
                <textarea id="description" placeholder="Description..." name="description">{{mythData.description}}</textarea>
                <button type="submit">create</button>
            </form>

        </div>
    </section>
</main>